# Use a key issued by the provider selected in BASE_URL.
LLM_API_KEY = your_provider_api_key
BASE_URL = https://api.deepseek.com
MODEL = deepseek-flash
# auto selects Chat Completions for Moonshot and GLM; other providers use Responses.
LLM_API_FORMAT = auto
# Optional image model. Defaults to MODEL when it supports images; GLM text
# models fall back to glm-4.6v-flash, and DeepSeek uses deepseek-flash.
# Set explicitly for any provider when its text model cannot accept images.
# VISION_MODEL = glm-4.6v-flash
# Moonshot Kimi K2.6 example:
# BASE_URL = https://api.moonshot.cn/v1
# MODEL = kimi-k2.6
# LLM_API_KEY = your_moonshot_api_key
# GLM example: BASE_URL must be the API root, without /chat/completions.
# BASE_URL = https://open.bigmodel.cn/api/paas/v4
# MODEL = glm-5.3-flash
# LLM_API_KEY = your_glm_api_key
ROLEPLAY_TIMING = false
# Print provider-reported input/cache/output token counts per LLM call.
LLM_CACHE_METRICS = false
# Scene-only: profile + recent dialogue + Scene retrieval + memory + lore; sticker selection follows generation.
ROLEPLAY_SCENE_ONLY_TOP_K = 10
# Master switch: false pauses roleplay memory injection and all updates without deleting stored data.
ROLEPLAY_MEMORY_ENABLED = true
# Caps the Scene-only Generator's completion reservation for Kimi TPM limits.
ROLEPLAY_GENERATOR_MAX_OUTPUT_TOKENS = 1024
# Optional trace-based Qwen ranking; requires local weights and Scene traces.
ROLEPLAY_SCENE_RETRIEVER_MODE = cosine
ROLEPLAY_SCENE_RERANKER_MODEL_PATH = ./models/Qwen3-Reranker-0.6B
ROLEPLAY_SCENE_RERANK_CANDIDATES = 16
APP_TIMEZONE = Asia/Shanghai
REMINDER_MODEL_TIMEOUT_SECONDS = 20
